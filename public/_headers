# Response headers, in the format Cloudflare and Netlify read. Only public/ is published.
# connect-src 'self' enforces the privacy promise: the page can call its own address only (the one send function), never another host.
# Styles allow 'unsafe-inline' because a few elements set a style attribute.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'none'
